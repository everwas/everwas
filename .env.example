# Copy to .env and adjust. Never commit .env.

# --- compose ---
COMPOSE_PROJECT_NAME=openrmm
# dev = hot reload + bind mounts + mailpit; prod = built images + caddy labels
OPENRMM_MODE=dev

# --- public hostnames (caddy-docker-proxy, both modes) ---
# The app and the API share ONE origin. The session cookie is HttpOnly and
# SameSite=Lax, so a separate API hostname would mean CORS plus SameSite=None
# plus a cross-site cookie, to solve nothing. Agents dial the same name at
# wss://$OPENRMM_DOMAIN/nats.
OPENRMM_DOMAIN=rmm.example.com
# MCP clients present a bearer API key rather than the browser session, so it
# gets its own origin. Defaults to mcp-$OPENRMM_DOMAIN.
OPENRMM_MCP_DOMAIN=mcp-rmm.example.com
# Dev only. Defaults to mail-$OPENRMM_DOMAIN.
OPENRMM_MAIL_DOMAIN=mail-rmm.example.com
# Agents connect here. It MUST be its own hostname serving at the root:
# nats.go ignores the path in a websocket URL, so wss://$OPENRMM_DOMAIN/nats
# lands on whatever handles "/" and never completes the handshake.
# Defaults to nats-$OPENRMM_DOMAIN.
OPENRMM_NATS_DOMAIN=nats-rmm.example.com

# --- postgres ---
POSTGRES_DB=openrmm
POSTGRES_USER=openrmm
POSTGRES_PASSWORD=change-me-strong-random

# --- server ---
# secret for session cookie signing / CSRF; generate: openssl rand -hex 32
OPENRMM_SECRET_KEY=change-me-openssl-rand-hex-32

# --- nats auth ---
# generate the pair with: cd server && uv run openrmm gen-nats-keys
OPENRMM_NATS_AUTH_SEED=
OPENRMM_NATS_AUTH_ISSUER=
# password for the internal `server` NATS user (api/dispatcher); openssl rand -hex 24
OPENRMM_NATS_SERVER_PASSWORD=change-me-strong-random
# What enrolled agents are told to dial: $OPENRMM_NATS_DOMAIN, at the root.
# Baked into each agent's config AT ENROLLMENT, so changing it later does not
# move agents that are already in the field.
OPENRMM_NATS_PUBLIC_URL=wss://nats-rmm.example.com

# --- smtp (prod; dev uses mailpit) ---
OPENRMM_SMTP_HOST=
OPENRMM_SMTP_PORT=587
OPENRMM_SMTP_USER=
OPENRMM_SMTP_PASSWORD=
OPENRMM_SMTP_FROM=openrmm@example.com

# --- mcp ---
# the MCP server is opt-in
OPENRMM_MCP_ENABLED=false

# Encrypts the device CA intermediate key at rest. Generate with:
#   openssl rand -base64 36
# Back this up separately from the server: losing it orphans every device
# certificate already issued.
OPENRMM_CA_PASSPHRASE=
