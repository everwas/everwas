# Copy to .env and adjust. Never commit .env.

# --- compose ---
COMPOSE_PROJECT_NAME=openrmm
# dev = hot reload + bind mounts + mailpit; prod = built images + caddy labels
OPENRMM_MODE=dev

# --- exposure (prod) ---
OPENRMM_DOMAIN=rmm.example.com

# --- postgres ---
POSTGRES_DB=openrmm
POSTGRES_USER=openrmm
POSTGRES_PASSWORD=change-me-strong-random

# --- server ---
# secret for session cookie signing / CSRF; generate: openssl rand -hex 32
OPENRMM_SECRET_KEY=change-me-openssl-rand-hex-32

# --- nats auth ---
# generate the pair with: cd server && uv run openrmm gen-nats-keys
OPENRMM_NATS_AUTH_SEED=
OPENRMM_NATS_AUTH_ISSUER=
# password for the internal `server` NATS user (api/dispatcher); openssl rand -hex 24
OPENRMM_NATS_SERVER_PASSWORD=change-me-strong-random
# what enrolled agents are told to dial (wss://$OPENRMM_DOMAIN/nats in prod)
OPENRMM_NATS_PUBLIC_URL=nats://localhost:24222

# --- smtp (prod; dev uses mailpit) ---
OPENRMM_SMTP_HOST=
OPENRMM_SMTP_PORT=587
OPENRMM_SMTP_USER=
OPENRMM_SMTP_PASSWORD=
OPENRMM_SMTP_FROM=openrmm@example.com

# --- mcp ---
# the MCP server is opt-in
OPENRMM_MCP_ENABLED=false
