# Copy to .env and adjust. Never commit .env.

# --- compose ---
COMPOSE_PROJECT_NAME=everwas
# dev = hot reload + bind mounts + mailpit; prod = built images + caddy labels
EVERWAS_MODE=dev

# --- public hostnames (caddy-docker-proxy, both modes) ---
# The app and the API share ONE origin. The session cookie is HttpOnly and
# SameSite=Lax, so a separate API hostname would mean CORS plus SameSite=None
# plus a cross-site cookie, to solve nothing. Agents dial the same name at
# wss://$EVERWAS_DOMAIN/nats.
EVERWAS_DOMAIN=rmm.example.com
# MCP clients present a bearer API key rather than the browser session, so it
# gets its own origin. Defaults to mcp-$EVERWAS_DOMAIN.
EVERWAS_MCP_DOMAIN=mcp-rmm.example.com
# Dev only. Defaults to mail-$EVERWAS_DOMAIN.
EVERWAS_MAIL_DOMAIN=mail-rmm.example.com
# Agents connect here. It MUST be its own hostname serving at the root:
# nats.go ignores the path in a websocket URL, so wss://$EVERWAS_DOMAIN/nats
# lands on whatever handles "/" and never completes the handshake.
# Defaults to nats-$EVERWAS_DOMAIN.
EVERWAS_NATS_DOMAIN=nats-rmm.example.com

# --- postgres ---
POSTGRES_DB=everwas
POSTGRES_USER=everwas
POSTGRES_PASSWORD=change-me-strong-random

# --- server ---
# secret for session cookie signing / CSRF; generate: openssl rand -hex 32
EVERWAS_SECRET_KEY=change-me-openssl-rand-hex-32

# --- nats auth ---
# generate the pair with: cd server && uv run everwas gen-nats-keys
EVERWAS_NATS_AUTH_SEED=
EVERWAS_NATS_AUTH_ISSUER=
# password for the internal `server` NATS user (api/dispatcher); openssl rand -hex 24
EVERWAS_NATS_SERVER_PASSWORD=change-me-strong-random
# What enrolled agents are told to dial: $EVERWAS_NATS_DOMAIN, at the root.
# Baked into each agent's config AT ENROLLMENT, so changing it later does not
# move agents that are already in the field.
EVERWAS_NATS_PUBLIC_URL=wss://nats-rmm.example.com

# --- smtp (prod; dev uses mailpit) ---
EVERWAS_SMTP_HOST=
EVERWAS_SMTP_PORT=587
EVERWAS_SMTP_USER=
EVERWAS_SMTP_PASSWORD=
EVERWAS_SMTP_FROM=everwas@example.com

# --- mcp ---
# the MCP server is opt-in
EVERWAS_MCP_ENABLED=false

# --- posture egress (opt-in) ---
# NATS subject each device's posture collection is pushed to for an access
# verifier (l2trace consumes `l2trace.posture`). Empty = egress off, the safe
# default: a verifier reads absence as not-assessed, and not-assessed never
# gates.
EVERWAS_POSTURE_EGRESS_SUBJECT=

# Encrypts the device CA intermediate key at rest. Generate with:
#   openssl rand -base64 36
# Back this up separately from the server: losing it orphans every device
# certificate already issued.
EVERWAS_CA_PASSPHRASE=

# Days an issued device certificate is valid. Default 90.
# Drop to 30 only once your 802.1X failure path lands devices on a
# remediation VLAN that can still reach this server (see ADR-0004);
# shortening it first makes expiry both likelier and unrecoverable.
EVERWAS_CA_CERT_LIFETIME_DAYS=
