---
import ProductShot from './ProductShot.astro';
---

<section id="console" class="section">
  <div class="container">
    <p class="section-kicker">The console</p>
    <h2 class="section-title">One screen that tells the truth</h2>
    <p class="section-lede">
      This is the real dashboard on the real dev fleet, not a mockup: live
      utilization per machine, alerts if there were any, and an activity feed
      that is the audit log itself. When it says quiet, it means quiet.
    </p>
    <ProductShot id="dashboard-overview" icon="lucide:layout-dashboard" />
  </div>
</section>
