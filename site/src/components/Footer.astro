---
// Site footer. Carries the two Supported Systems house conventions:
//   1. An on-theme easter egg — here, a 1U rack strip whose LEDs you can
//      poke into an alert state and acknowledge (cooldown included).
//   2. The 90s-webring-style "A Supported System" badge + modal.
import './Footer.css';
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <span>Open<em>RMM</em></span>
      </a>
      <p>Open-source remote monitoring and management for Windows, macOS, and Linux.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="https://github.com/openrmm">GitHub</a>
      <a href="#features">Features</a>
      <a href="#time-machine">Bitemporal history</a>
      <a href="#mcp">MCP server</a>
      <a href="#quick-start">Quick start</a>
      <a href="/licensing">Licensing</a>
      <a href="/privacy">Privacy</a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">© 2026 OpenRMM contributors · AGPL-3.0 server · Apache-2.0 agent</p>

    <!-- ===== 1U rack easter egg ===== -->
    <div class="rack" role="group" aria-label="Decorative rack unit">
      <span class="rack-ear" aria-hidden="true"></span>
      <span class="rack-label">1U</span>
      <button id="rack-led" class="rack-leds" type="button" aria-label="Status LEDs (poke at your own risk)" title="All systems nominal">
        <span class="led led-a"></span>
        <span class="led led-b"></span>
        <span class="led led-c"></span>
      </button>
      <span class="rack-ear" aria-hidden="true"></span>
      <span id="rack-toast" class="rack-toast" role="status" aria-live="polite"></span>
    </div>

    <!-- ===== Supported Systems webring badge ===== -->
    <button id="ss-badge" class="webring-badge" type="button" title="A Supported System">
      <img src="/supported-systems-logo.svg" alt="" width="28" height="20" />
      <span>A Supported System</span>
    </button>
  </div>

  <!-- ===== modal ===== -->
  <div id="ss-modal" class="ss-modal hidden" role="dialog" aria-modal="true" aria-label="About Supported Systems">
    <div class="ss-card">
      <button id="ss-close" class="ss-close" type="button" aria-label="Close">×</button>
      <div class="ss-logo"><img src="/supported-systems-logo.svg" alt="Supported Systems" width="64" height="48" /></div>
      <h3>A Supported Systems Joint</h3>
      <p>OpenRMM is stewarded by Supported Systems, a boutique studio for thoughtful, user-first infrastructure.</p>
      <a class="ss-visit" href="https://supported.systems" target="_blank" rel="noopener noreferrer">Visit supported.systems &rarr;</a>
      <p class="ss-hint">Psst, the rack LEDs in the footer are live. Alerts have cooldowns here too.</p>
    </div>
  </div>
</footer>

<script>
  // ---- rack LED easter egg: poke → alert → acknowledge → cooldown ----
  const leds = document.getElementById('rack-led');
  const toastEl = document.getElementById('rack-toast');
  let toastT: ReturnType<typeof setTimeout>;
  let cooldownUntil = 0;

  function toast(msg: string) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastT);
    toastT = setTimeout(() => toastEl.classList.remove('show'), 2400);
  }

  leds?.addEventListener('click', () => {
    const now = Date.now();
    if (leds.classList.contains('alerting')) {
      leds.classList.remove('alerting');
      cooldownUntil = now + 8000;
      toast('✓ acknowledged · cooldown 5m (footer time: 8s)');
    } else if (now < cooldownUntil) {
      toast('cooldown active, the alert rules are working');
    } else {
      leds.classList.add('alerting');
      toast('▲ disk 92% on win-lab-3 — click to acknowledge');
    }
  });

  // ---- Supported Systems modal ----
  const modal = document.getElementById('ss-modal');
  const open = () => modal?.classList.remove('hidden');
  const close = () => modal?.classList.add('hidden');
  document.getElementById('ss-badge')?.addEventListener('click', open);
  document.getElementById('ss-close')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
