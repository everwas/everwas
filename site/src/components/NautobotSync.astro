---
import { Icon } from 'astro-icon/components';
import ProductShot from './ProductShot.astro';
import './NautobotSync.css';

const points = [
  {
    icon: 'lucide:layers',
    title: 'Bitemporal on arrival',
    body: 'Every synced fact carries both of its timestamps: when it was true on the machine, and when the server learned it. Nautobot inherits the memory, not a snapshot of it.',
  },
  {
    icon: 'lucide:repeat',
    title: 'Nothing to do twice',
    body: 'The sync is idempotent. It diffs against what Nautobot already holds and applies only the difference, so a second run right after the first finds an empty diff and says so.',
  },
  {
    icon: 'lucide:server',
    title: 'Promotion into DCIM',
    body: 'An endpoint can be promoted to a full Device with its interfaces, and Prefixes and IP addresses derive from the CIDR addresses agents report. Inventory becomes infrastructure records without retyping anything.',
  },
];
---

<section id="nautobot" class="section nbs">
  <div class="container">
    <p class="section-kicker">Nautobot integration</p>
    <h2 class="section-title">The fleet, in your source of truth</h2>
    <p class="section-lede">
      <code>nautobot-ssot-everwas</code> is a first-party SSoT app that syncs
      what the agents report into Nautobot: endpoints, interfaces, installed
      software, patch state, and per-check security posture. It reads the same
      sync API any other system of record would.
    </p>

    <ProductShot id="nautobot-posture-checks" icon="lucide:database" />

    <div class="nbs-points">
      {points.map((p) => (
        <div class="nbs-point">
          <Icon name={p.icon} size={19} />
          <div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
