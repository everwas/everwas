---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Console from '../components/Console.astro';
import TimeMachine from '../components/TimeMachine.astro';
import McpSection from '../components/McpSection.astro';
import NautobotSync from '../components/NautobotSync.astro';
import Constellation from '../components/Constellation.astro';
import Architecture from '../components/Architecture.astro';
import QuickStart from '../components/QuickStart.astro';
import OpenSource from '../components/OpenSource.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Everwas · Remote monitoring with a memory"
  description="Open-source remote monitoring and management for Windows, macOS, and Linux. Telemetry, alerting, browser terminal, scripts, patching, and bitemporal device history. AGPL server, Apache agent, self-hosted."
>
  <Nav />
  <main>
    <Hero />
    <Features />
    <Console />
    <TimeMachine />
    <McpSection />
    <NautobotSync />
    <Constellation />
    <Architecture />
    <QuickStart />
    <OpenSource />
  </main>
  <Footer />
</BaseLayout>
